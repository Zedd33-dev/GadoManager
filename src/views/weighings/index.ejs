<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<h1>Pesagens</h1>
<p class="lead"><%= fmt.formatNumber(pageInfo.totalRows) %> pesagem(ns) registrada(s).</p>

<form method="get" action="/pesagens" class="filter-bar" aria-label="Filtros de pesagens">
  <div class="filter-field filter-field--grow">
    <label for="q">Buscar por brinco</label>
    <input type="search" id="q" name="q" value="<%= filters.search ?? '' %>" placeholder="Ex.: BV-0001">
  </div>
  <div class="filter-field">
    <label for="lote">Lote</label>
    <select id="lote" name="lote">
      <option value="">Todos</option>
      <% lots.forEach(function (lot) { %>
        <option value="<%= lot.id %>" <%= filters.lotId === lot.id ? 'selected' : '' %>>
          <%= lot.name %> — <%= lot.farm_name %>
        </option>
      <% }); %>
    </select>
  </div>
  <div class="filter-field">
    <label for="de">De</label>
    <input type="date" id="de" name="de" value="<%= filters.from ?? '' %>">
  </div>
  <div class="filter-field">
    <label for="ate">Até</label>
    <input type="date" id="ate" name="ate" value="<%= filters.until ?? '' %>">
  </div>
  <button type="submit" class="button button--primary filter-submit">Filtrar</button>
</form>

<div class="list-toolbar">
  <% if (userCan('weighings:write')) { %>
    <a href="/pesagens/lote" class="button button--primary">Pesagem em lote</a>
  <% } %>
  <a href="/pesagens/exportar.csv?<%= csvQuery %>" class="button">Exportar CSV</a>
</div>

<% if (rows.length === 0) { %>
  <p class="empty-state">
    Nenhuma pesagem encontrada com os filtros atuais.
    <% if (userCan('weighings:write')) { %>
      — <a href="/pesagens/lote">registrar pesagem</a>.
    <% } %>
  </p>
<% } else { %>
  <div class="table-scroll">
    <table class="table table--responsive">
      <caption class="visually-hidden">Lista de pesagens</caption>
      <thead>
        <tr>
          <% [['weighDate','Data'],['earTag','Brinco'],['lot','Lote'],['weight','Peso']].forEach(function (col) { %>
            <th scope="col">
              <a href="?<%= buildSortQuery(col[0]) %>" class="sort-link <%= sort.key === col[0] ? 'sort-link--active' : '' %>">
                <%= col[1] %><% if (sort.key === col[0]) { %> <%= sort.direction === 'asc' ? '▲' : '▼' %><% } %>
              </a>
            </th>
          <% }); %>
          <th scope="col">Desde a anterior</th>
          <th scope="col">GMD</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (row) { %>
          <tr>
            <th scope="row"><%= fmt.formatDate(row.weigh_date) %></th>
            <td data-label="Brinco"><a href="/animais/<%= row.animal_id %>"><%= row.ear_tag %></a></td>
            <td data-label="Lote"><%= row.lot_name ?? '—' %></td>
            <td data-label="Peso"><%= fmt.formatWeight(row.weight_kg) %></td>
            <td data-label="Desde a anterior">
              <% if (row.prev_kg === null) { %>
                <span class="hint">Primeira pesagem</span>
              <% } else {
                   const delta = row.weight_kg - row.prev_kg; %>
                <span class="<%= delta < 0 ? 'delta delta--negative' : 'delta delta--positive' %>">
                  <%= delta >= 0 ? '+' : '' %><%= fmt.formatNumber(delta, 1) %> kg
                </span>
              <% } %>
            </td>
            <td data-label="GMD"><%= fmt.formatGmd(row.gmd) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <nav class="pagination" aria-label="Paginação">
    <p class="pagination__summary">
      Mostrando <%= fmt.formatNumber(pageInfo.rangeStart) %>–<%= fmt.formatNumber(pageInfo.rangeEnd) %>
      de <%= fmt.formatNumber(pageInfo.totalRows) %>
    </p>
    <div class="pagination__controls">
      <a class="button <%= pageInfo.hasPrevious ? '' : 'is-disabled' %>"
         href="?<%= buildPageQuery(pageInfo.page - 1) %>"
         aria-disabled="<%= pageInfo.hasPrevious ? 'false' : 'true' %>">Anterior</a>
      <span class="pagination__page">Página <%= pageInfo.page %> de <%= pageInfo.totalPages %></span>
      <a class="button <%= pageInfo.hasNext ? '' : 'is-disabled' %>"
         href="?<%= buildPageQuery(pageInfo.page + 1) %>"
         aria-disabled="<%= pageInfo.hasNext ? 'false' : 'true' %>">Próxima</a>
    </div>
  </nav>
<% } %>

<script src="/static/js/nav.js" defer></script>

<%- include('../partials/foot') %>
