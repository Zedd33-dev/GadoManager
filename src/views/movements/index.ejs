<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<h1>Movimentações</h1>
<p class="lead"><%= fmt.formatNumber(pageInfo.totalRows) %> movimentação(ões) registrada(s).</p>

<form method="get" action="/movimentacoes" class="filter-bar" aria-label="Filtros">
  <div class="filter-field filter-field--grow">
    <label for="q">Buscar por brinco</label>
    <input type="search" id="q" name="q" value="<%= filters.search ?? '' %>">
  </div>
  <div class="filter-field">
    <label for="de">De</label>
    <input type="date" id="de" name="de" value="<%= filters.from ?? '' %>">
  </div>
  <div class="filter-field">
    <label for="ate">Até</label>
    <input type="date" id="ate" name="ate" value="<%= filters.until ?? '' %>">
  </div>
  <button type="submit" class="button button--primary filter-submit">Filtrar</button>
</form>

<div class="list-toolbar">
  <% if (userCan('movements:write')) { %>
    <a href="/movimentacoes/nova" class="button button--primary">Nova movimentação</a>
  <% } %>
  <a href="/movimentacoes/exportar.csv?<%= csvQuery %>" class="button">Exportar CSV</a>
</div>

<% if (rows.length === 0) { %>
  <p class="empty-state">
    Nenhuma movimentação encontrada.
    <% if (userCan('movements:write')) { %>
      — <a href="/movimentacoes/nova">registrar movimentação</a>.
    <% } %>
  </p>
<% } else { %>
  <div class="table-scroll">
    <table class="table table--responsive">
      <caption class="visually-hidden">Histórico de movimentações</caption>
      <thead>
        <tr>
          <% [['movedAt','Data'],['earTag','Brinco']].forEach(function (col) { %>
            <th scope="col">
              <a href="?<%= buildSortQuery(col[0]) %>" class="sort-link <%= sort.key === col[0] ? 'sort-link--active' : '' %>">
                <%= col[1] %><% if (sort.key === col[0]) { %> <%= sort.direction === 'asc' ? '▲' : '▼' %><% } %>
              </a>
            </th>
          <% }); %>
          <th scope="col">Origem</th>
          <th scope="col">Destino</th>
          <th scope="col">Motivo</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (row) { %>
          <tr>
            <th scope="row"><%= fmt.formatDate(row.moved_at.slice(0, 10)) %></th>
            <td data-label="Brinco"><a href="/animais/<%= row.animal_id %>"><%= row.ear_tag %></a></td>
            <td data-label="Origem">
              <%= row.from_lot ?? '—' %>
              <% if (row.from_pasture) { %><span class="hint"><%= row.from_pasture %></span><% } %>
              <% if (row.from_farm !== row.to_farm) { %>
                <span class="badge badge--warning"><%= row.from_farm %></span>
              <% } %>
            </td>
            <td data-label="Destino">
              <%= row.to_lot ?? '—' %>
              <% if (row.to_pasture) { %><span class="hint"><%= row.to_pasture %></span><% } %>
              <% if (row.from_farm !== row.to_farm) { %>
                <span class="badge badge--info"><%= row.to_farm %></span>
              <% } %>
            </td>
            <td data-label="Motivo"><%= row.reason ?? '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <nav class="pagination" aria-label="Paginação">
    <p class="pagination__summary">
      Mostrando <%= fmt.formatNumber(pageInfo.rangeStart) %>–<%= fmt.formatNumber(pageInfo.rangeEnd) %>
      de <%= fmt.formatNumber(pageInfo.totalRows) %>
    </p>
    <div class="pagination__controls">
      <a class="button <%= pageInfo.hasPrevious ? '' : 'is-disabled' %>"
         href="?<%= buildPageQuery(pageInfo.page - 1) %>"
         aria-disabled="<%= pageInfo.hasPrevious ? 'false' : 'true' %>">Anterior</a>
      <span class="pagination__page">Página <%= pageInfo.page %> de <%= pageInfo.totalPages %></span>
      <a class="button <%= pageInfo.hasNext ? '' : 'is-disabled' %>"
         href="?<%= buildPageQuery(pageInfo.page + 1) %>"
         aria-disabled="<%= pageInfo.hasNext ? 'false' : 'true' %>">Próxima</a>
    </div>
  </nav>
<% } %>

<script src="/static/js/nav.js" defer></script>

<%- include('../partials/foot') %>
