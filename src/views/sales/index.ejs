<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<h1>Vendas</h1>
<p class="lead"><%= fmt.formatNumber(pageInfo.totalRows) %> venda(s) registrada(s).</p>

<form method="get" action="/vendas" class="filter-bar" aria-label="Filtros">
  <div class="filter-field filter-field--grow">
    <label for="q">Buscar por comprador</label>
    <input type="search" id="q" name="q" value="<%= filters.search ?? '' %>">
  </div>
  <div class="filter-field">
    <label for="de">De</label>
    <input type="date" id="de" name="de" value="<%= filters.from ?? '' %>">
  </div>
  <div class="filter-field">
    <label for="ate">Até</label>
    <input type="date" id="ate" name="ate" value="<%= filters.until ?? '' %>">
  </div>
  <button type="submit" class="button button--primary filter-submit">Filtrar</button>
</form>

<div class="list-toolbar">
  <% if (userCan('sales:write')) { %>
    <a href="/vendas/nova" class="button button--primary">Nova venda</a>
  <% } %>
  <a href="/vendas/exportar.csv?<%= csvQuery %>" class="button">Exportar CSV</a>
</div>

<% if (rows.length === 0) { %>
  <p class="empty-state">
    Nenhuma venda encontrada.
    <% if (userCan('sales:write')) { %> — <a href="/vendas/nova">registrar venda</a>.<% } %>
  </p>
<% } else { %>
  <div class="table-scroll">
    <table class="table table--responsive">
      <caption class="visually-hidden">Histórico de vendas</caption>
      <thead>
        <tr>
          <% [['saleDate','Data'],['buyer','Comprador']].forEach(function (col) { %>
            <th scope="col">
              <a href="?<%= buildSortQuery(col[0]) %>" class="sort-link <%= sort.key === col[0] ? 'sort-link--active' : '' %>">
                <%= col[1] %><% if (sort.key === col[0]) { %> <%= sort.direction === 'asc' ? '▲' : '▼' %><% } %>
              </a>
            </th>
          <% }); %>
          <th scope="col">Animais</th>
          <th scope="col">Arrobas</th>
          <th scope="col">Preço/@</th>
          <th scope="col">Valor total</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (row) { %>
          <tr>
            <th scope="row"><a href="/vendas/<%= row.id %>"><%= fmt.formatDate(row.sale_date) %></a></th>
            <td data-label="Comprador"><%= row.buyer_name %></td>
            <td data-label="Animais"><%= fmt.formatNumber(row.animal_count) %></td>
            <td data-label="Arrobas"><%= fmt.formatArrobas(row.total_arrobas) %></td>
            <td data-label="Preço/@"><%= fmt.formatCurrency(row.price_per_arroba_cents) %></td>
            <td data-label="Valor total"><%= fmt.formatCurrency(row.total_value_cents) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <nav class="pagination" aria-label="Paginação">
    <p class="pagination__summary">
      Mostrando <%= fmt.formatNumber(pageInfo.rangeStart) %>–<%= fmt.formatNumber(pageInfo.rangeEnd) %>
      de <%= fmt.formatNumber(pageInfo.totalRows) %>
    </p>
    <div class="pagination__controls">
      <a class="button <%= pageInfo.hasPrevious ? '' : 'is-disabled' %>"
         href="?<%= buildPageQuery(pageInfo.page - 1) %>"
         aria-disabled="<%= pageInfo.hasPrevious ? 'false' : 'true' %>">Anterior</a>
      <span class="pagination__page">Página <%= pageInfo.page %> de <%= pageInfo.totalPages %></span>
      <a class="button <%= pageInfo.hasNext ? '' : 'is-disabled' %>"
         href="?<%= buildPageQuery(pageInfo.page + 1) %>"
         aria-disabled="<%= pageInfo.hasNext ? 'false' : 'true' %>">Próxima</a>
    </div>
  </nav>
<% } %>

<script src="/static/js/nav.js" defer></script>

<%- include('../partials/foot') %>
