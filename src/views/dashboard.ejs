<%- include('partials/head') %>
<%- include('partials/nav') %>

<h1>Painel</h1>
<p class="lead">Visão geral do rebanho no escopo selecionado.</p>

<form method="get" action="/" class="filter-bar" aria-label="Filtros do painel">
  <div class="filter-field">
    <label for="fazenda">Fazenda</label>
    <select id="fazenda" name="fazenda">
      <option value="">Todas</option>
      <% filters.farms.forEach(function (farm) { %>
        <option value="<%= farm.id %>" <%= filters.farmId === farm.id ? 'selected' : '' %>>
          <%= farm.name %>
        </option>
      <% }); %>
    </select>
  </div>

  <div class="filter-field">
    <label for="lote">Lote</label>
    <select id="lote" name="lote">
      <option value="">Todos</option>
      <% filters.lots.forEach(function (lot) { %>
        <option value="<%= lot.id %>" <%= filters.lotId === lot.id ? 'selected' : '' %>>
          <%= lot.name %> — <%= lot.farm_name %>
        </option>
      <% }); %>
    </select>
  </div>

  <div class="filter-field">
    <label for="status">Status do animal</label>
    <select id="status" name="status">
      <% statusOptions.forEach(function (value) { %>
        <option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>>
          <%= statusLabels[value] %>
        </option>
      <% }); %>
    </select>
  </div>

  <div class="filter-field">
    <label for="periodo">Período (custos)</label>
    <select id="periodo" name="periodo">
      <option value="mes" <%= filters.period.preset === 'mes' ? 'selected' : '' %>>Mês atual</option>
      <option value="30" <%= filters.period.preset === '30' ? 'selected' : '' %>>Últimos 30 dias</option>
      <option value="90" <%= filters.period.preset === '90' ? 'selected' : '' %>>Últimos 90 dias</option>
      <option value="180" <%= filters.period.preset === '180' ? 'selected' : '' %>>Últimos 180 dias</option>
      <option value="ano" <%= filters.period.preset === 'ano' ? 'selected' : '' %>>Este ano</option>
      <option value="custom" <%= filters.period.preset === 'custom' ? 'selected' : '' %>>Personalizado</option>
    </select>
  </div>

  <% if (filters.period.preset === 'custom') { %>
    <div class="filter-field">
      <label for="de">De</label>
      <input type="date" id="de" name="de" value="<%= filters.period.customFrom %>">
    </div>
    <div class="filter-field">
      <label for="ate">Até</label>
      <input type="date" id="ate" name="ate" value="<%= filters.period.customUntil %>">
    </div>
  <% } %>

  <button type="submit" class="button button--primary filter-submit">Filtrar</button>
</form>

<section aria-labelledby="titulo-kpis">
  <h2 id="titulo-kpis" class="visually-hidden">Indicadores</h2>

  <% if (kpis.herd.total === 0) { %>
    <p class="empty-state">Nenhum animal cadastrado neste escopo.</p>
  <% } else { %>
    <div class="kpi-grid">

      <article class="kpi-card">
        <h3>Animais (total)</h3>
        <p class="kpi-value"><%= fmt.formatNumber(kpis.herd.total) %></p>
      </article>

      <article class="kpi-card">
        <h3>Rebanho por status</h3>
        <p class="kpi-value">
          <%= fmt.formatNumber(herdCountByStatus[filters.status]) %>
          <span class="kpi-unit"><%= statusLabels[filters.status] %></span>
        </p>
        <ul class="status-chips">
          <% statusOptions.forEach(function (value) { %>
            <li>
              <a
                class="chip <%= filters.status === value ? 'chip--active' : '' %>"
                href="/?<%= buildFilterQuery({ status: value }) %>"
              >
                <%= statusLabels[value] %> (<%= fmt.formatNumber(herdCountByStatus[value]) %>)
              </a>
            </li>
          <% }); %>
        </ul>
      </article>

      <article class="kpi-card" title="<%= kpis.averageWeight.explanation %>">
        <h3>Peso médio (última pesagem)</h3>
        <% if (kpis.averageWeight.value === null) { %>
          <p class="kpi-value">—</p>
          <p class="kpi-empty"><%= kpis.averageWeight.emptyMessage %></p>
        <% } else { %>
          <p class="kpi-value"><%= fmt.formatWeight(kpis.averageWeight.value) %></p>
          <p class="kpi-meta">n = <%= kpis.averageWeight.animalCount %></p>
        <% } %>
      </article>

      <article class="kpi-card" title="<%= kpis.averageDailyGain.explanation %>">
        <h3>GMD médio</h3>
        <% if (kpis.averageDailyGain.value === null) { %>
          <p class="kpi-value">—</p>
          <p class="kpi-empty"><%= kpis.averageDailyGain.emptyMessage %></p>
        <% } else { %>
          <p class="kpi-value"><%= fmt.formatGmd(kpis.averageDailyGain.value) %></p>
          <p class="kpi-meta">n = <%= kpis.averageDailyGain.animalCount %></p>
        <% } %>
      </article>

      <article class="kpi-card" title="<%= kpis.withoutRecentWeighing.explanation %>">
        <h3>Sem pesagem (<%= kpis.withoutRecentWeighing.windowDays %> dias)</h3>
        <% if (kpis.withoutRecentWeighing.value === 0) { %>
          <p class="kpi-value">—</p>
          <p class="kpi-empty">Todos os animais ativos foram pesados recentemente.</p>
        <% } else { %>
          <p class="kpi-value"><%= fmt.formatNumber(kpis.withoutRecentWeighing.value) %></p>
          <p class="kpi-meta"><%= fmt.formatNumber(kpis.withoutRecentWeighing.neverWeighed) %> nunca pesado(s)</p>
        <% } %>
      </article>

      <article class="kpi-card" title="<%= kpis.monthlyCost.explanation %>">
        <h3><%= kpis.monthlyCost.periodLabel %></h3>
        <% if (kpis.monthlyCost.value === null) { %>
          <p class="kpi-value">—</p>
          <p class="kpi-empty"><%= kpis.monthlyCost.emptyMessage %></p>
        <% } else { %>
          <p class="kpi-value"><%= fmt.formatCurrency(kpis.monthlyCost.value) %></p>
          <p class="kpi-meta"><%= kpis.monthlyCost.entryCount %> lançamento(s)</p>
        <% } %>
      </article>

      <article class="kpi-card">
        <h3>Fazendas / Lotes</h3>
        <p class="kpi-value"><%= kpis.structure.farms %> / <%= kpis.structure.lots %></p>
      </article>

    </div>
  <% } %>
</section>

<section aria-labelledby="titulo-alertas">
  <h2 id="titulo-alertas">Alertas</h2>

  <% if (!kpis.healthAlerts.hasAny) { %>
    <p class="empty-state">Nenhum alerta sanitário no momento.</p>
  <% } else { %>
    <ul class="alert-list">
      <% if (kpis.healthAlerts.overdueVaccineDoses > 0) { %>
        <li class="alert-row alert-row--danger">
          <span class="badge badge--danger"><%= kpis.healthAlerts.overdueVaccineDoses %></span>
          <span>
            <%= kpis.healthAlerts.overdueVaccineDoses %> dose(s) de vacina atrasada(s)
            em <%= kpis.healthAlerts.overdueAnimals %> animal(is)
          </span>
        </li>
      <% } %>
      <% if (kpis.healthAlerts.overdueTreatmentDoses > 0) { %>
        <li class="alert-row alert-row--danger">
          <span class="badge badge--danger"><%= kpis.healthAlerts.overdueTreatmentDoses %></span>
          <span>
            <%= kpis.healthAlerts.overdueTreatmentDoses %> tratamento(s) atrasado(s)
            em <%= kpis.healthAlerts.overdueAnimals %> animal(is)
          </span>
        </li>
      <% } %>
      <% if (kpis.healthAlerts.dueSoonDoses > 0) { %>
        <li class="alert-row alert-row--info">
          <span class="badge badge--info"><%= kpis.healthAlerts.dueSoonDoses %></span>
          <span>
            dose(s) a vencer nos próximos <%= kpis.healthAlerts.windowDays %> dias
            (<%= kpis.healthAlerts.dueSoonAnimals %> animal(is))
          </span>
        </li>
      <% } %>
    </ul>
    <p class="hint">
      A navegação direta para a lista de vacinas e tratamentos será adicionada
      quando o módulo correspondente for implementado (Fase 10).
    </p>
  <% } %>
  <p class="hint"><%= kpis.healthAlerts.explanation %></p>
</section>

<section aria-labelledby="titulo-graficos">
  <h2 id="titulo-graficos">Gráficos</h2>
  <p class="hint">
    Cada gráfico tem uma tabela equivalente, com os mesmos números — abra
    "Ver dados em tabela" para consultar sem depender do gráfico.
  </p>

  <div class="chart-grid">

    <article class="chart-card">
      <h3 id="titulo-grafico-status">Status do rebanho</h3>
      <% if (charts.herdStatus.total === 0) { %>
        <p class="empty-state">Nenhum animal cadastrado neste escopo.</p>
      <% } else { %>
        <div class="chart-canvas-wrapper">
          <canvas
            id="chart-herd-status"
            role="img"
            aria-label="Gráfico de rosca mostrando a distribuição do rebanho por status"
            aria-describedby="tabela-grafico-status"
          ></canvas>
        </div>
        <details>
          <summary>Ver dados em tabela</summary>
          <table class="table table--responsive" id="tabela-grafico-status">
            <caption class="visually-hidden">Distribuição do rebanho por status</caption>
            <thead>
              <tr><th scope="col">Status</th><th scope="col">Animais</th><th scope="col">%</th></tr>
            </thead>
            <tbody>
              <% charts.herdStatus.rows.forEach(function (row) { %>
                <tr>
                  <th scope="row"><%= row.status %></th>
                  <td data-label="Animais"><%= fmt.formatNumber(row.count) %></td>
                  <td data-label="%"><%= fmt.formatPercent(row.percent === null ? null : row.percent * 100) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </details>
      <% } %>
    </article>

    <article class="chart-card">
      <h3 id="titulo-grafico-peso-lote">Peso médio por lote</h3>
      <% if (charts.weightByLot.labels.length === 0) { %>
        <p class="empty-state">Nenhuma pesagem registrada — registrar pesagem.</p>
      <% } else { %>
        <div class="chart-canvas-wrapper">
          <canvas
            id="chart-weight-by-lot"
            role="img"
            aria-label="Gráfico de barras comparando o peso médio entre lotes, com a média do rebanho como referência"
            aria-describedby="tabela-grafico-peso-lote"
          ></canvas>
        </div>
        <details>
          <summary>Ver dados em tabela</summary>
          <table class="table table--responsive" id="tabela-grafico-peso-lote">
            <caption class="visually-hidden">Peso médio por lote</caption>
            <thead>
              <tr><th scope="col">Lote</th><th scope="col">Peso médio</th><th scope="col">Animais</th></tr>
            </thead>
            <tbody>
              <% charts.weightByLot.rows.forEach(function (row) { %>
                <tr>
                  <th scope="row"><%= row.lot %></th>
                  <td data-label="Peso médio"><%= fmt.formatWeight(row.averageKg) %></td>
                  <td data-label="Animais"><%= fmt.formatNumber(row.animalCount) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </details>
      <% } %>
    </article>

    <article class="chart-card">
      <h3 id="titulo-grafico-composicao">Composição do rebanho</h3>
      <p class="hint">
        Classificação por idade e sexo. Como o sistema não registra status
        reprodutivo, a categoria é aproximada apenas pela idade.
      </p>
      <% if (charts.herdComposition.labels.length === 0) { %>
        <p class="empty-state">Nenhum animal ativo neste escopo.</p>
      <% } else { %>
        <div class="chart-canvas-wrapper">
          <canvas
            id="chart-herd-composition"
            role="img"
            aria-label="Gráfico de barras mostrando a composição do rebanho por faixa etária e sexo"
            aria-describedby="tabela-grafico-composicao"
          ></canvas>
        </div>
        <details>
          <summary>Ver dados em tabela</summary>
          <table class="table table--responsive" id="tabela-grafico-composicao">
            <caption class="visually-hidden">Composição do rebanho por faixa etária e sexo</caption>
            <thead>
              <tr><th scope="col">Faixa</th><th scope="col">Machos</th><th scope="col">Fêmeas</th><th scope="col">Total</th></tr>
            </thead>
            <tbody>
              <% charts.herdComposition.rows.forEach(function (row) { %>
                <tr>
                  <th scope="row"><%= row.range %></th>
                  <td data-label="Machos"><%= fmt.formatNumber(row.male) %></td>
                  <td data-label="Fêmeas"><%= fmt.formatNumber(row.female) %></td>
                  <td data-label="Total"><%= fmt.formatNumber(row.total) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </details>
      <% } %>
    </article>

    <article class="chart-card">
      <h3 id="titulo-grafico-evolucao-peso">Evolução do peso médio</h3>
      <p class="hint">
        Últimos 12 meses, por lote. Inclui pesagens de animais que já saíram
        do rebanho — um histórico não deve esconder o que realmente aconteceu.
      </p>
      <% if (charts.weightEvolution.series.length === 0) { %>
        <p class="empty-state">Nenhuma pesagem registrada nos últimos 12 meses.</p>
      <% } else { %>
        <div class="chart-canvas-wrapper">
          <canvas
            id="chart-weight-evolution"
            role="img"
            aria-label="Gráfico de linhas mostrando a evolução do peso médio por lote ao longo dos últimos 12 meses"
            aria-describedby="tabela-grafico-evolucao-peso"
          ></canvas>
        </div>
        <details>
          <summary>Ver dados em tabela</summary>
          <table class="table table--responsive" id="tabela-grafico-evolucao-peso">
            <caption class="visually-hidden">Evolução mensal do peso médio por lote</caption>
            <thead>
              <tr><th scope="col">Mês</th><th scope="col">Lote</th><th scope="col">Peso médio</th></tr>
            </thead>
            <tbody>
              <% charts.weightEvolution.rows.forEach(function (row) { %>
                <tr>
                  <th scope="row"><%= row.month %></th>
                  <td data-label="Lote"><%= row.lot %></td>
                  <td data-label="Peso médio"><%= fmt.formatWeight(row.averageKg) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </details>
      <% } %>
    </article>

    <article class="chart-card">
      <h3 id="titulo-grafico-gmd">Curva de GMD</h3>
      <p class="hint">Últimos 12 meses, por lote.</p>
      <% if (charts.gmdCurve.series.length === 0) { %>
        <p class="empty-state">Sem pesagens suficientes para calcular o GMD nos últimos 12 meses.</p>
      <% } else { %>
        <div class="chart-canvas-wrapper">
          <canvas
            id="chart-gmd-curve"
            role="img"
            aria-label="Gráfico de linhas mostrando o ganho médio diário por lote ao longo dos últimos 12 meses"
            aria-describedby="tabela-grafico-gmd"
          ></canvas>
        </div>
        <details>
          <summary>Ver dados em tabela</summary>
          <table class="table table--responsive" id="tabela-grafico-gmd">
            <caption class="visually-hidden">GMD mensal por lote</caption>
            <thead>
              <tr><th scope="col">Mês</th><th scope="col">Lote</th><th scope="col">GMD</th></tr>
            </thead>
            <tbody>
              <% charts.gmdCurve.rows.forEach(function (row) { %>
                <tr>
                  <th scope="row"><%= row.month %></th>
                  <td data-label="Lote"><%= row.lot %></td>
                  <td data-label="GMD"><%= fmt.formatGmd(row.averageGmd) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </details>
      <% } %>
    </article>

    <article class="chart-card">
      <h3 id="titulo-grafico-custos">Custos por categoria</h3>
      <p class="hint">Últimos 12 meses<% if (filters.lotId) { %>, apenas custos deste lote<% } %>.</p>
      <% if (charts.costsByCategory.series.length === 0) { %>
        <p class="empty-state">Nenhum custo lançado nos últimos 12 meses.</p>
      <% } else { %>
        <div class="chart-canvas-wrapper">
          <canvas
            id="chart-costs-by-category"
            role="img"
            aria-label="Gráfico de barras empilhadas mostrando os custos mensais por categoria"
            aria-describedby="tabela-grafico-custos"
          ></canvas>
        </div>
        <details>
          <summary>Ver dados em tabela</summary>
          <table class="table table--responsive" id="tabela-grafico-custos">
            <caption class="visually-hidden">Custos mensais por categoria</caption>
            <thead>
              <tr><th scope="col">Mês</th><th scope="col">Categoria</th><th scope="col">Valor</th></tr>
            </thead>
            <tbody>
              <% charts.costsByCategory.rows.forEach(function (row) { %>
                <tr>
                  <th scope="row"><%= row.month %></th>
                  <td data-label="Categoria"><%= row.category %></td>
                  <td data-label="Valor"><%= fmt.formatCurrency(row.amountCents) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </details>
      <% } %>
    </article>

  </div>
</section>

<details class="diagnostics">
  <summary>Diagnóstico do sistema</summary>

  <h3>Suas permissões</h3>
  <ul class="capability-list">
    <li>
      Registrar pesagens:
      <span class="badge badge--<%= userCan('weighings:write') ? 'success' : 'danger' %>">
        <%= userCan('weighings:write') ? 'permitido' : 'negado' %>
      </span>
    </li>
    <li>
      Cadastrar animais:
      <span class="badge badge--<%= userCan('animals:write') ? 'success' : 'danger' %>">
        <%= userCan('animals:write') ? 'permitido' : 'negado' %>
      </span>
    </li>
    <li>
      Registrar vendas:
      <span class="badge badge--<%= userCan('sales:write') ? 'success' : 'danger' %>">
        <%= userCan('sales:write') ? 'permitido' : 'negado' %>
      </span>
    </li>
    <li>
      Gerenciar fazendas:
      <span class="badge badge--<%= userCan('farms:write') ? 'success' : 'danger' %>">
        <%= userCan('farms:write') ? 'permitido' : 'negado' %>
      </span>
    </li>
  </ul>

  <h3>Migrações do banco de dados</h3>
  <% if (migrations.length === 0) { %>
    <p class="empty-state">Nenhuma migração encontrada.</p>
  <% } else { %>
    <ul class="migration-list">
      <% migrations.forEach(function (migration) { %>
        <li>
          <span class="badge badge--<%= migration.applied ? 'success' : 'warning' %>">
            <%= migration.applied ? 'aplicada' : 'pendente' %>
          </span>
          <code><%= migration.filename %></code>
        </li>
      <% }); %>
    </ul>
  <% } %>
</details>

<script src="/static/js/nav.js" defer></script>
<script src="/static/js/filterBar.js" defer></script>
<script type="application/json" id="chart-data"><%- chartsJson %></script>
<script src="/static/vendor/chartjs/chart.umd.js" defer></script>
<script src="/static/js/charts.js" defer></script>

<%- include('partials/foot') %>
