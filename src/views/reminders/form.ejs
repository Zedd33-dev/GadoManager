<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<h1><%= isCreate ? 'Novo lembrete' : 'Editar lembrete' %></h1>

<form method="post" action="<%= isCreate ? '/lembretes' : `/lembretes/${reminder.id}/editar` %>" class="record-form" novalidate>
  <%- include('../partials/csrfField') %>

  <div class="field">
    <label for="title">Título</label>
    <input type="text" id="title" name="title" value="<%= values.title ?? '' %>" required maxlength="120"
           aria-invalid="<%= errors.title ? 'true' : 'false' %>">
    <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
  </div>

  <div class="field">
    <label for="description">Descrição (opcional)</label>
    <textarea id="description" name="description" rows="2" maxlength="500"><%= values.description ?? '' %></textarea>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="dueDate">Data</label>
      <input type="date" id="dueDate" name="dueDate" value="<%= values.dueDate ?? '' %>" required
             aria-invalid="<%= errors.dueDate ? 'true' : 'false' %>">
      <% if (errors.dueDate) { %><p class="field-error"><%= errors.dueDate %></p><% } %>
    </div>

    <div class="field">
      <label for="recurrence">Recorrência</label>
      <select id="recurrence" name="recurrence">
        <option value="nenhuma" <%= values.recurrence === 'nenhuma' ? 'selected' : '' %>>Nenhuma</option>
        <option value="semanal" <%= values.recurrence === 'semanal' ? 'selected' : '' %>>Semanal</option>
        <option value="mensal" <%= values.recurrence === 'mensal' ? 'selected' : '' %>>Mensal</option>
        <option value="anual" <%= values.recurrence === 'anual' ? 'selected' : '' %>>Anual</option>
      </select>
      <p class="hint">Ao concluir, um lembrete recorrente cria a próxima ocorrência automaticamente.</p>
    </div>
  </div>

  <button type="submit" class="button button--primary"><%= isCreate ? 'Criar' : 'Salvar alterações' %></button>
  <a href="/lembretes" class="button">Cancelar</a>
</form>

<script src="/static/js/nav.js" defer></script>

<%- include('../partials/foot') %>
