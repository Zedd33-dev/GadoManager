<dialog class="confirm-dialog" id="confirm-delete-dialog">
  <form method="dialog">
    <h2>Confirmar exclusão</h2>
    <p id="confirm-delete-message">Esta ação não pode ser desfeita.</p>
    <div class="confirm-dialog__actions">
      <button type="submit" value="cancel" class="button">Cancelar</button>
      <button type="submit" value="confirm" class="button button--danger" id="confirm-delete-button">Excluir</button>
    </div>
  </form>
</dialog>
