<header class="app-header">
  <div class="app-header__bar">
    <a class="app-brand" href="/">GadoManager</a>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="app-nav-menu">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="visually-hidden">Abrir menu</span>
    </button>

    <nav id="app-nav-menu" class="app-nav" aria-label="Navegação principal">
      <ul>
        <li>
          <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Painel</a>
        </li>
        <li>
          <a href="/animais" class="<%= currentPath.startsWith('/animais') ? 'is-active' : '' %>">Animais</a>
        </li>
        <li>
          <a href="/pesagens" class="<%= currentPath.startsWith('/pesagens') ? 'is-active' : '' %>">Pesagens</a>
        </li>
        <li>
          <a href="/vacinas" class="<%= currentPath.startsWith('/vacinas') ? 'is-active' : '' %>">Vacinas</a>
        </li>
        <li>
          <a href="/tratamentos" class="<%= currentPath.startsWith('/tratamentos') ? 'is-active' : '' %>">Tratamentos</a>
        </li>
        <li>
          <a href="/movimentacoes" class="<%= currentPath.startsWith('/movimentacoes') ? 'is-active' : '' %>">Movimentações</a>
        </li>
        <li>
          <a href="/vendas" class="<%= currentPath.startsWith('/vendas') ? 'is-active' : '' %>">Vendas</a>
        </li>
        <li>
          <a href="/custos" class="<%= currentPath.startsWith('/custos') ? 'is-active' : '' %>">Custos</a>
        </li>
        <li>
          <a href="/lembretes" class="<%= currentPath.startsWith('/lembretes') ? 'is-active' : '' %>">Lembretes</a>
        </li>
        <li>
          <a href="/lotes" class="<%= currentPath.startsWith('/lotes') ? 'is-active' : '' %>">Lotes</a>
        </li>
        <li>
          <a href="/pastos" class="<%= currentPath.startsWith('/pastos') ? 'is-active' : '' %>">Pastos</a>
        </li>
        <li>
          <a href="/fazendas" class="<%= currentPath.startsWith('/fazendas') ? 'is-active' : '' %>">Fazendas</a>
        </li>
      </ul>
    </nav>

    <div class="user-box">
      <span><strong><%= currentUser.name %></strong> — <%= roleLabel %></span>
      <form method="post" action="/logout">
        <%- include('csrfField') %>
        <button type="submit" class="button">Sair</button>
      </form>
    </div>
  </div>
</header>
