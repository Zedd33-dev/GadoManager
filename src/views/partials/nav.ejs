<header class="app-header">
  <div class="app-header__bar">
    <a class="app-brand" href="/">GadoManager</a>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="app-nav-menu">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="visually-hidden">Abrir menu</span>
    </button>

    <nav id="app-nav-menu" class="app-nav" aria-label="Navegação principal">
      <form method="get" action="/animais" class="header-search" role="search">
        <label for="header-search-q" class="visually-hidden">Buscar animal por brinco</label>
        <input type="search" id="header-search-q" name="q" placeholder="Buscar por brinco..." value="<%= typeof headerSearchQuery === 'string' ? headerSearchQuery : '' %>">
        <button type="submit" class="button header-search__button" aria-label="Buscar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M21 21l-4.35-4.35"></path>
          </svg>
        </button>
      </form>
      <ul>
        <li>
          <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Painel</a>
        </li>
        <li>
          <a href="/animais" class="<%= currentPath.startsWith('/animais') ? 'is-active' : '' %>">Animais</a>
        </li>
        <li>
          <a href="/pesagens" class="<%= currentPath.startsWith('/pesagens') ? 'is-active' : '' %>">Pesagens</a>
        </li>
        <li>
          <a href="/vacinas" class="<%= currentPath.startsWith('/vacinas') ? 'is-active' : '' %>">Vacinas</a>
        </li>
        <li>
          <a href="/tratamentos" class="<%= currentPath.startsWith('/tratamentos') ? 'is-active' : '' %>">Tratamentos</a>
        </li>
        <li>
          <a href="/movimentacoes" class="<%= currentPath.startsWith('/movimentacoes') ? 'is-active' : '' %>">Movimentações</a>
        </li>
        <li>
          <a href="/vendas" class="<%= currentPath.startsWith('/vendas') ? 'is-active' : '' %>">Vendas</a>
        </li>
        <li>
          <a href="/custos" class="<%= currentPath.startsWith('/custos') ? 'is-active' : '' %>">Custos</a>
        </li>
        <li>
          <a href="/lembretes" class="<%= currentPath.startsWith('/lembretes') ? 'is-active' : '' %>">Lembretes</a>
        </li>
        <li>
          <a href="/lotes" class="<%= currentPath.startsWith('/lotes') ? 'is-active' : '' %>">Lotes</a>
        </li>
        <li>
          <a href="/pastos" class="<%= currentPath.startsWith('/pastos') ? 'is-active' : '' %>">Pastos</a>
        </li>
        <li>
          <a href="/fazendas" class="<%= currentPath.startsWith('/fazendas') ? 'is-active' : '' %>">Fazendas</a>
        </li>
        <li>
          <a href="/relatorios/rebanho" class="<%= currentPath.startsWith('/relatorios') ? 'is-active' : '' %>">Relatórios</a>
        </li>
      </ul>
    </nav>

    <div class="user-box">
      <button type="button" class="button theme-toggle" data-theme-toggle aria-label="Alternar tema claro/escuro">
        <svg class="theme-toggle__icon--light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="theme-toggle__icon--dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <span><strong><%= currentUser.name %></strong> — <%= roleLabel %></span>
      <form method="post" action="/logout">
        <%- include('csrfField') %>
        <button type="submit" class="button">Sair</button>
      </form>
    </div>
  </div>
</header>
