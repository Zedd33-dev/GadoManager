<%- include('partials/head') %>

<h1>GadoManager</h1>
<p class="lead">
  Sistema de gestão de rebanho bovino de corte. Estrutura inicial (Fase 0) —
  o painel completo será construído nas próximas fases.
</p>

<section aria-labelledby="titulo-migracoes">
  <h2 id="titulo-migracoes">Migrações do banco de dados</h2>

  <% if (migrations.length === 0) { %>
    <p class="empty-state">
      Nenhuma migração encontrada. O esquema do banco será criado na Fase 1.
    </p>
  <% } else { %>
    <ul class="migration-list">
      <% migrations.forEach(function (migration) { %>
        <li>
          <span class="badge badge--<%= migration.applied ? 'success' : 'warning' %>">
            <%= migration.applied ? 'aplicada' : 'pendente' %>
          </span>
          <code><%= migration.filename %></code>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>

<section aria-labelledby="titulo-formatacao">
  <h2 id="titulo-formatacao">Verificação de formatação pt-BR</h2>
  <p class="hint">
    Confirma que a camada de formatação central está ativa e que valores
    ausentes aparecem como travessão, nunca como zero.
  </p>

  <table class="table">
    <caption class="visually-hidden">Exemplos de formatação em português do Brasil</caption>
    <thead>
      <tr><th scope="col">Tipo</th><th scope="col">Valor</th></tr>
    </thead>
    <tbody>
      <tr><th scope="row">Data</th><td><%= fmt.formatDate('2026-03-15') %></td></tr>
      <tr><th scope="row">Moeda</th><td><%= fmt.formatCurrency(123456) %></td></tr>
      <tr><th scope="row">Peso</th><td><%= fmt.formatWeight(1234.5) %></td></tr>
      <tr><th scope="row">GMD</th><td><%= fmt.formatGmd(0.85) %></td></tr>
      <tr><th scope="row">Lotação</th><td><%= fmt.formatStockingRate(1.25) %></td></tr>
      <tr><th scope="row">Sem dados</th><td><%= fmt.formatWeight(null) %></td></tr>
    </tbody>
  </table>
</section>

<%- include('partials/foot') %>
