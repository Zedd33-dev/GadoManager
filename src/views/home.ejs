<%- include('partials/head') %>

<header class="page-header">
  <div>
    <h1>GadoManager</h1>
    <p class="lead">Estrutura inicial — o painel completo chega na Fase 5.</p>
  </div>

  <div class="user-box">
    <span><strong><%= currentUser.name %></strong> — <%= roleLabel %></span>
    <form method="post" action="/logout">
      <%- include('partials/csrfField') %>
      <button type="submit" class="button">Sair</button>
    </form>
  </div>
</header>

<section aria-labelledby="titulo-rebanho">
  <h2 id="titulo-rebanho">Rebanho no seu escopo</h2>
  <p class="hint">
    Somente animais das fazendas às quais sua conta tem acesso são contabilizados.
  </p>

  <table class="table">
    <caption class="visually-hidden">Contagem de animais visíveis para a conta atual</caption>
    <thead>
      <tr><th scope="col">Indicador</th><th scope="col">Valor</th></tr>
    </thead>
    <tbody>
      <tr><th scope="row">Fazendas acessíveis</th><td><%= scope.farmIds.length %></td></tr>
      <tr><th scope="row">Animais (total)</th><td><%= fmt.formatNumber(animalCount) %></td></tr>
      <tr><th scope="row">Ativos</th><td><%= fmt.formatNumber(activeCount) %></td></tr>
    </tbody>
  </table>
</section>

<section aria-labelledby="titulo-permissoes">
  <h2 id="titulo-permissoes">Suas permissões</h2>
  <p class="hint">
    Verificadas no servidor antes de cada ação — ocultar um botão não é controle
    de acesso.
  </p>

  <ul class="capability-list">
    <li>
      Registrar pesagens:
      <span class="badge badge--<%= userCan('weighings:write') ? 'success' : 'danger' %>">
        <%= userCan('weighings:write') ? 'permitido' : 'negado' %>
      </span>
    </li>
    <li>
      Cadastrar animais:
      <span class="badge badge--<%= userCan('animals:write') ? 'success' : 'danger' %>">
        <%= userCan('animals:write') ? 'permitido' : 'negado' %>
      </span>
    </li>
    <li>
      Registrar vendas:
      <span class="badge badge--<%= userCan('sales:write') ? 'success' : 'danger' %>">
        <%= userCan('sales:write') ? 'permitido' : 'negado' %>
      </span>
    </li>
    <li>
      Gerenciar fazendas:
      <span class="badge badge--<%= userCan('farms:write') ? 'success' : 'danger' %>">
        <%= userCan('farms:write') ? 'permitido' : 'negado' %>
      </span>
    </li>
  </ul>
</section>

<section aria-labelledby="titulo-migracoes">
  <h2 id="titulo-migracoes">Migrações do banco de dados</h2>

  <% if (migrations.length === 0) { %>
    <p class="empty-state">Nenhuma migração encontrada.</p>
  <% } else { %>
    <ul class="migration-list">
      <% migrations.forEach(function (migration) { %>
        <li>
          <span class="badge badge--<%= migration.applied ? 'success' : 'warning' %>">
            <%= migration.applied ? 'aplicada' : 'pendente' %>
          </span>
          <code><%= migration.filename %></code>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>

<%- include('partials/foot') %>
