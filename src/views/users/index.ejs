<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<h1>Usuários</h1>
<p class="lead">Contas do sistema, cargos e acesso a fazendas.</p>

<% if (users.length === 0) { %>
  <p class="empty-state">Nenhum usuário cadastrado.</p>
<% } else { %>
  <div class="table-scroll">
    <table class="table table--responsive">
      <caption class="visually-hidden">Usuários</caption>
      <thead>
        <tr>
          <th scope="col">Nome</th>
          <th scope="col">E-mail</th>
          <th scope="col">Cargo</th>
          <th scope="col">Fazendas</th>
          <th scope="col">Situação</th>
          <th scope="col">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function (u) { %>
          <tr>
            <th scope="row" data-label="Nome"><%= u.name %></th>
            <td data-label="E-mail"><%= u.email %></td>
            <td data-label="Cargo"><%= roleLabels[u.role] ?? u.role %></td>
            <td data-label="Fazendas"><%= u.farm_count %></td>
            <td data-label="Situação">
              <span class="badge badge--<%= u.active ? 'success' : 'warning' %>">
                <%= u.active ? 'Ativo' : 'Desativado' %>
              </span>
            </td>
            <td data-label="Ações"><a href="/usuarios/<%= u.id %>/editar">Editar</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<script src="/static/js/nav.js" defer></script>

<%- include('../partials/foot') %>
