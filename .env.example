# Copy this file to `.env` and adjust as needed.
# `.env` is gitignored; this example is the documented contract.

# Port the HTTP server listens on.
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Path to the SQLite database file, relative to the project root.
DB_PATH=data/gadomanager.db

# Secret used to sign session cookies.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-before-running-anything-real
